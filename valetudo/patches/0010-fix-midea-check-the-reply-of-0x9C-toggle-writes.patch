From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dominik Krivohlavek <github@xkrivo.net>
Date: Wed, 4 Nov 2026 19:22:26 +0100
Subject: [PATCH 10/28] fix(midea): check the reply of 0x9C toggle writes

The firmware answers SET_VARIOUS_TOGGLES with [aa 01 9c result id value],
result 0 for OK and 1 for an unknown id, an out-of-range value or an
unsupported case. Valetudo never looked at it, so a rejected toggle
looked successful until the next poll.

Add MSmartToggles.setToggle(robot, id, value) and assertToggleReply()
and use setToggle in the toggle capabilities (key lock, camera light,
obstacle images, AI obstacle avoidance, pet mode, mop extension,
furniture legs, mop auto drying, carpet sensor v1 and the auto-empty
interval v3 toggle). A non-zero result throws.

MideaQuirkFactory, collision avoidant navigation and mop twist are not
converted here.

Based on static analysis of the 0x9C handler; untested on the robot.

diff --git a/backend/lib/msmart/MSmartToggles.js b/backend/lib/msmart/MSmartToggles.js
new file mode 100644
index 00000000..6e967461
--- /dev/null
+++ b/backend/lib/msmart/MSmartToggles.js
@@ -0,0 +1,43 @@
+const MSmartConst = require("./MSmartConst");
+const MSmartPacket = require("./MSmartPacket");
+
+/**
+ * The reply to SET_VARIOUS_TOGGLES is [aa 01 9c result id value] with result 0 for OK
+ * and 1 for an unknown id, an out-of-range value or an unsupported case
+ *
+ * @param {import("./MSmartPacket")} response
+ * @param {number} toggleId
+ * @returns {void}
+ */
+function assertToggleReply(response, toggleId) {
+    const result = response?.payload?.[3];
+
+    if (result !== 0x00) {
+        throw new Error(`Setting toggle 0x${toggleId.toString(16)} failed. Robot replied with result ${result}`);
+    }
+}
+
+/**
+ * Sets a SET_VARIOUS_TOGGLES toggle and throws if the robot rejects it
+ *
+ * @param {{sendCommand: function(string, object=): Promise<import("./MSmartPacket")>}} robot
+ * @param {number} toggleId
+ * @param {number} value
+ * @returns {Promise<void>}
+ */
+async function setToggle(robot, toggleId, value) {
+    const response = await robot.sendCommand(new MSmartPacket({
+        messageType: MSmartPacket.MESSAGE_TYPE.SETTING,
+        payload: MSmartPacket.buildPayload(
+            MSmartConst.SETTING.SET_VARIOUS_TOGGLES,
+            Buffer.from([toggleId, value])
+        )
+    }).toHexString());
+
+    assertToggleReply(response, toggleId);
+}
+
+module.exports = {
+    assertToggleReply: assertToggleReply,
+    setToggle: setToggle
+};
