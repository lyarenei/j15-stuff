From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Dominik Krivohlavek <github@xkrivo.net>
Date: Wed, 4 Nov 2026 19:20:10 +0100
Subject: [PATCH 06/31] fix(midea): don't report J15 volume 0 while DND silence
 is active

The firmware forces the voice_level status byte to 0 while the DND
silent state is active, so the UI showed volume 0 at night and a
read-modify-write could persist it.

The status carries no DND state, so when the volume reads 0 the
capability checks the DND configuration: if DND is enabled and the
current time is inside its window, the last non-zero volume seen (or
set) through this capability is returned instead. If no non-zero volume
is known yet, 0 is still returned.

Based on static analysis of the status builder; untested on the robot.

diff --git a/backend/lib/robots/midea/capabilities/MideaSpeakerVolumeControlCapabilityV2.js b/backend/lib/robots/midea/capabilities/MideaSpeakerVolumeControlCapabilityV2.js
index d897c2bd..fd869835 100644
--- a/backend/lib/robots/midea/capabilities/MideaSpeakerVolumeControlCapabilityV2.js
+++ b/backend/lib/robots/midea/capabilities/MideaSpeakerVolumeControlCapabilityV2.js
@@ -1,4 +1,5 @@
 const BEightParser = require("../../../msmart/BEightParser");
+const DoNotDisturbCapability = require("../../../core/capabilities/DoNotDisturbCapability");
 const MSmartConst = require("../../../msmart/MSmartConst");
 const MSmartPacket = require("../../../msmart/MSmartPacket");
 const MSmartStatusDTO = require("../../../msmart/dtos/MSmartStatusDTO");
@@ -8,6 +9,16 @@ const SpeakerVolumeControlCapability = require("../../../core/capabilities/Speak
  * @extends SpeakerVolumeControlCapability<import("../MideaValetudoRobot")>
  */
 class MideaSpeakerVolumeControlCapabilityV2 extends SpeakerVolumeControlCapability {
+    /**
+     * @param {object} options
+     * @param {import("../MideaValetudoRobot")} options.robot
+     */
+    constructor(options) {
+        super(options);
+
+        /** @type {number} */
+        this.lastKnownVolume = 0;
+    }
 
     /**
      * Returns the current voice volume as percentage
@@ -24,12 +35,48 @@ class MideaSpeakerVolumeControlCapabilityV2 extends SpeakerVolumeControlCapabili
         const parsedResponse = BEightParser.PARSE(response);
 
         if (parsedResponse instanceof MSmartStatusDTO) {
-            return parsedResponse.voice_level ?? 0;
+            const volume = parsedResponse.voice_level ?? 0;
+
+            if (volume > 0) {
+                this.lastKnownVolume = volume;
+            } else if (this.lastKnownVolume > 0 && await this.isDndSilenceActive()) {
+                // The firmware reports 0 while DND silence is active, which is not the configured volume
+                return this.lastKnownVolume;
+            }
+
+            return volume;
         } else {
             throw new Error("Invalid response from robot");
         }
     }
 
+    /**
+     * @private
+     * @returns {Promise<boolean>}
+     */
+    async isDndSilenceActive() {
+        try {
+            const dnd = await this.robot.capabilities[DoNotDisturbCapability.TYPE]?.getDndConfiguration();
+
+            if (!dnd?.enabled) {
+                return false;
+            }
+
+            const now = new Date();
+            const nowMinutes = now.getHours() * 60 + now.getMinutes();
+            const startMinutes = dnd.start.hour * 60 + dnd.start.minute;
+            const endMinutes = dnd.end.hour * 60 + dnd.end.minute;
+
+            if (startMinutes <= endMinutes) {
+                return nowMinutes >= startMinutes && nowMinutes < endMinutes;
+            }
+
+            return nowMinutes >= startMinutes || nowMinutes < endMinutes;
+        } catch (e) {
+            return false;
+        }
+    }
+
     /**
      * Sets the speaker volume
      *
@@ -39,6 +86,8 @@ class MideaSpeakerVolumeControlCapabilityV2 extends SpeakerVolumeControlCapabili
     async setVolume(value) {
         // TODO: validate 0-100?
 
+        this.lastKnownVolume = value;
+
