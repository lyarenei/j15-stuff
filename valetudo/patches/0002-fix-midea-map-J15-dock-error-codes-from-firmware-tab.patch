                     type: stateAttrs.DockComponentStateAttribute.TYPE.WATER_TANK_DIRTY,
-                    value: data.station_error_code === 152 ?
-                        stateAttrs.DockComponentStateAttribute.VALUE.FULL :
-                        stateAttrs.DockComponentStateAttribute.VALUE.OK,
