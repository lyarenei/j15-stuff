diff --git a/backend/lib/robots/midea/MideaTankwatchState.js b/backend/lib/robots/midea/MideaTankwatchState.js
new file mode 100644
index 00000000..58982ae2
--- /dev/null
+++ b/backend/lib/robots/midea/MideaTankwatchState.js
@@ -0,0 +1,80 @@
+const fs = require("node:fs");
+
+const STATE_FILE = "/userdata/tankwatch/state.json";
+const RESET_FLAG_FILES = Object.freeze({
+    clean: "/tmp/tankwatch.reset-clean",
+    dirty: "/tmp/tankwatch.reset-dirty"
+});
+
+let cache = {key: null, state: null};
+
+/**
+ * @param {*} tank
+ * @returns {{remainingPercent: number, low: boolean}|null}
+ */
+function parseTank(tank) {
+    if (
+        tank === null || typeof tank !== "object" ||
+        !Number.isInteger(tank.remaining_pct) || tank.remaining_pct < 0 || tank.remaining_pct > 100 ||
+        typeof tank.low !== "boolean"
+    ) {
+        return null;
+    }
+
+    return {remainingPercent: tank.remaining_pct, low: tank.low};
+}
+
+/**
+ * Reads the estimate written by the tankwatch daemon. The parsed file is cached until its mtime or size changes.
+ * Anything unexpected means that there is no estimate.
+ *
+ * @param {string} [file]
+ * @returns {{clean: {remainingPercent: number, low: boolean}|null, dirty: {remainingPercent: number, low: boolean}|null}|null}
+ */
+function read(file = STATE_FILE) {
+    let key;
+    try {
+        const stat = fs.statSync(file);
+        key = `${file}:${stat.mtimeMs}:${stat.size}`;
+    } catch (e) {
+        cache = {key: null, state: null};
+        return null;
+    }
+
+    if (cache.key === key) {
+        return cache.state;
+    }
+
+    let state = null;
+    try {
+        const parsed = JSON.parse(fs.readFileSync(file, "utf8"));
+
+        if (parsed !== null && typeof parsed === "object" && parsed.version === 1) {
+            const clean = parseTank(parsed.clean);
+            const dirty = parseTank(parsed.dirty);
+
+            if (clean || dirty) {
+                state = {clean: clean, dirty: dirty};
+            }
+        }
+    } catch (e) {
+        state = null;
+    }
+
+    cache = {key: key, state: state};
+    return state;
+}
+
+/**
+ * @param {"clean"|"dirty"} tank
+ */
+function requestReset(tank) {
+    fs.writeFileSync(RESET_FLAG_FILES[tank], "");
+}
+
+module.exports = {
+    STATE_FILE: STATE_FILE,
+    RESET_FLAG_FILES: RESET_FLAG_FILES,
+    read: read,
+    requestReset: requestReset
+};
diff --git a/backend/lib/robots/midea/capabilities/MideaTankwatchConsumableMonitoringCapability.js b/backend/lib/robots/midea/capabilities/MideaTankwatchConsumableMonitoringCapability.js
new file mode 100644
index 00000000..bbcd2e7c
--- /dev/null
+++ b/backend/lib/robots/midea/capabilities/MideaTankwatchConsumableMonitoringCapability.js
@@ -0,0 +1,71 @@
+const ConsumableMonitoringCapability = require("../../../core/capabilities/ConsumableMonitoringCapability");
+const MideaTankwatchState = require("../MideaTankwatchState");
+const ValetudoConsumable = require("../../../entities/core/ValetudoConsumable");
+
+const TANKS = Object.freeze({
+    [ValetudoConsumable.SUB_TYPE.CLEAN]: "clean",
+    [ValetudoConsumable.SUB_TYPE.DIRTY]: "dirty"
+});
+
+/**
+ * @extends ConsumableMonitoringCapability<import("../MideaValetudoRobot")>
+ */
+class MideaTankwatchConsumableMonitoringCapability extends ConsumableMonitoringCapability {
+    /**
+     * @returns {Promise<Array<ValetudoConsumable>>}
+     */
+    async getConsumables() {
+        const state = MideaTankwatchState.read();
+        const consumables = [];
+
+        Object.entries(TANKS).forEach(([subType, tank]) => {
+            const estimate = state?.[tank];
+
+            if (estimate) {
+                consumables.push(new ValetudoConsumable({
+                    type: ValetudoConsumable.TYPE.WATER_TANK,
+                    subType: subType,
+                    remaining: {
+                        value: estimate.remainingPercent,
+                        unit: ValetudoConsumable.UNITS.PERCENT
+                    }
+                }));
+            }
+        });
+
+        this.raiseEventIfRequired(consumables);
+
+        return consumables;
+    }
+
+    /**
+     * @param {string} type
+     * @param {string} [subType]
+     * @returns {Promise<void>}
+     */
+    async resetConsumable(type, subType) {
+        const tank = TANKS[subType];
+
+        if (type !== ValetudoConsumable.TYPE.WATER_TANK || !tank) {
+            throw new Error(`Unknown consumable ${type}, ${subType}`);
+        }
+
+        MideaTankwatchState.requestReset(tank);
+        this.markEventsAsProcessed(type, subType);
+    }
+
+    getProperties() {
+        return {
+            availableConsumables: Object.keys(TANKS).map(subType => {
+                return {
+                    type: ValetudoConsumable.TYPE.WATER_TANK,
+                    subType: subType,
+                    unit: ValetudoConsumable.UNITS.PERCENT,
+                    maxValue: 100
+                };
+            })
+        };
+    }
+}
+
+module.exports = MideaTankwatchConsumableMonitoringCapability;
