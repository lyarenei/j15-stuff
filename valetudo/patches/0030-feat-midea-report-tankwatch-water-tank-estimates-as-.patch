diff --git a/backend/test/lib/robots/midea/MideaTankwatchState_test.js b/backend/test/lib/robots/midea/MideaTankwatchState_test.js
new file mode 100644
index 00000000..30a315c4
--- /dev/null
+++ b/backend/test/lib/robots/midea/MideaTankwatchState_test.js
@@ -0,0 +1,70 @@
+const assert = require("node:assert");
+const fs = require("node:fs");
+const os = require("node:os");
+const path = require("node:path");
+const { describe, it, beforeEach, afterEach } = require("node:test");
+
+const MideaTankwatchState = require("../../../../lib/robots/midea/MideaTankwatchState");
+
+const VALID = {
+    version: 1,
+    updated: 1700000000,
+    clean: {used_ml: 1000, capacity_ml: 2600, remaining_pct: 62, low: false, reset: 1699990000},
+    dirty: {used_ml: 500, capacity_ml: 2000, remaining_pct: 74, low: true, reset: 1699990000}
+};
+
+describe("MideaTankwatchState", () => {
+    let dir;
+    let file;
+
+    beforeEach(() => {
+        dir = fs.mkdtempSync(path.join(os.tmpdir(), "tankwatch-"));
+        file = path.join(dir, "state.json");
+    });
+
+    afterEach(() => {
+        fs.rmSync(dir, {recursive: true, force: true});
+    });
+
+    it("reads a valid state file", () => {
+        fs.writeFileSync(file, JSON.stringify(VALID));
+
+        assert.deepStrictEqual(MideaTankwatchState.read(file), {
+            clean: {remainingPercent: 62, low: false},
+            dirty: {remainingPercent: 74, low: true}
+        });
+    });
+
+    it("has no estimate without a file", () => {
+        assert.strictEqual(MideaTankwatchState.read(file), null);
+    });
+
+    it("has no estimate for malformed or unknown versions", () => {
+        fs.writeFileSync(file, "{nope");
+        assert.strictEqual(MideaTankwatchState.read(file), null);
+
+        fs.writeFileSync(file, JSON.stringify({...VALID, version: 2}));
+        assert.strictEqual(MideaTankwatchState.read(file), null);
+
+        fs.writeFileSync(file, JSON.stringify({version: 1, clean: {remaining_pct: "a", low: false}}));
+        assert.strictEqual(MideaTankwatchState.read(file), null);
+    });
+
+    it("drops only the tank that is invalid", () => {
+        fs.writeFileSync(file, JSON.stringify({...VALID, dirty: {remaining_pct: 140, low: false}}));
+
+        assert.deepStrictEqual(MideaTankwatchState.read(file), {
+            clean: {remainingPercent: 62, low: false},
+            dirty: null
+        });
+    });
+
+    it("picks up changes to the file", () => {
+        fs.writeFileSync(file, JSON.stringify(VALID));
+        MideaTankwatchState.read(file);
+
+        fs.writeFileSync(file, JSON.stringify({...VALID, clean: {...VALID.clean, remaining_pct: 10, low: true}}));
+
+        assert.deepStrictEqual(MideaTankwatchState.read(file).clean, {remainingPercent: 10, low: true});
+    });
+});
